[
  {
    "id": "q001",
    "ruby": "学[まな]びて時[とき]に之[これ]を習[なら]う、亦[ま]た説[よろこ]ばしからずや。",
    "author": "孔子とされる言葉",
    "source": "『論語』学而",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q002",
    "ruby": "温[おん]故[こ]知[ち]新[しん]。",
    "author": "孔子とされる言葉",
    "source": "『論語』為政",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q003",
    "ruby": "己[おのれ]の欲[ほっ]せざる所[ところ]、人[ひと]に施[ほどこ]すこと勿[なか]れ。",
    "author": "孔子とされる言葉",
    "source": "『論語』衛霊公",
    "category": "人との関わり",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q004",
    "ruby": "三[さん]人[にん]行[おこな]えば、必[かなら]ず我[わ]が師[し]有[あ]り。",
    "author": "孔子とされる言葉",
    "source": "『論語』述而",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q005",
    "ruby": "過[あやま]ちて改[あらた]めざる、是[これ]を過[あやま]ちと謂[い]う。",
    "author": "孔子とされる言葉",
    "source": "『論語』衛霊公",
    "category": "成長",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q006",
    "ruby": "知[し]るを知[し]ると為[な]し、知[し]らざるを知[し]らずと為[な]す、是[こ]れ知[し]るなり。",
    "author": "孔子とされる言葉",
    "source": "『論語』為政",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q007",
    "ruby": "朝[あした]に道[みち]を聞[き]かば、夕[ゆう]べに死[し]すとも可[か]なり。",
    "author": "孔子とされる言葉",
    "source": "『論語』里仁",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q008",
    "ruby": "君[くん]子[し]は和[わ]して同[どう]ぜず、小[しょう]人[じん]は同[どう]じて和[わ]せず。",
    "author": "孔子とされる言葉",
    "source": "『論語』子路",
    "category": "人との関わり",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q009",
    "ruby": "知[ち]者[しゃ]は惑[まど]わず、仁[じん]者[しゃ]は憂[うれ]えず、勇[ゆう]者[しゃ]は懼[おそ]れず。",
    "author": "孔子とされる言葉",
    "source": "『論語』子罕",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q010",
    "ruby": "巧[こう]言[げん]令[れい]色[しょく]、鮮[すく]なし仁[じん]。",
    "author": "孔子とされる言葉",
    "source": "『論語』学而",
    "category": "人との関わり",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q011",
    "ruby": "学[まな]びて思[おも]わざれば則[すなわ]ち罔[くら]し、思[おも]いて学[まな]ばざれば則[すなわ]ち殆[あやう]し。",
    "author": "孔子とされる言葉",
    "source": "『論語』為政",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q012",
    "ruby": "歳[とし]寒[さむ]くして、然[しか]る後[のち]に松[しょう]柏[はく]の彫[しぼ]むに後[おく]るるを知[し]る。",
    "author": "孔子とされる言葉",
    "source": "『論語』子罕",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q013",
    "ruby": "其[そ]の身[み]正[ただ]しければ令[れい]せずして行[おこな]われ、其[そ]の身[み]正[ただ]しからざれば令[れい]すといえども従[したが]わず。",
    "author": "孔子とされる言葉",
    "source": "『論語』子路",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q014",
    "ruby": "之[これ]を知[し]る者[もの]は之[これ]を好[この]む者[もの]に如[し]かず、之[これ]を好[この]む者[もの]は之[これ]を楽[たの]しむ者[もの]に如[し]かず。",
    "author": "孔子とされる言葉",
    "source": "『論語』雍也",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q015",
    "ruby": "君[くん]子[し]坦[たん]蕩[とう]蕩[とう]、小[しょう]人[じん]長[ちょう]戚[せき]戚[せき]。",
    "author": "孔子とされる言葉",
    "source": "『論語』述而",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q016",
    "ruby": "仁[じん]遠[とお]からんや、我[わ]れ仁[じん]を欲[ほっ]すれば斯[ここ]に仁[じん]至[いた]る。",
    "author": "孔子とされる言葉",
    "source": "『論語』述而",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q017",
    "ruby": "知[ち]者[しゃ]は水[みず]を楽[たの]しみ、仁[じん]者[しゃ]は山[やま]を楽[たの]しむ。",
    "author": "孔子とされる言葉",
    "source": "『論語』雍也",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q018",
    "ruby": "後[こう]生[せい]畏[おそ]るべし。",
    "author": "孔子とされる言葉",
    "source": "『論語』子罕",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q019",
    "ruby": "逝[ゆ]く者[もの]は斯[か]くの如[ごと]きか、昼[ちゅう]夜[や]を舎[お]かず。",
    "author": "孔子とされる言葉",
    "source": "『論語』子罕",
    "category": "時間",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q020",
    "ruby": "天[てん]を怨[うら]みず、人[ひと]を尤[とが]めず。",
    "author": "孔子とされる言葉",
    "source": "『論語』憲問",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/論語"
  },
  {
    "id": "q021",
    "ruby": "千[せん]里[り]の行[こう]も、足[あし]下[もと]より始[はじ]まる。",
    "author": "老子とされる言葉",
    "source": "『老子道徳経』",
    "category": "一歩",
    "sourceUrl": "https://ja.wikisource.org/wiki/老子道徳経"
  },
  {
    "id": "q022",
    "ruby": "上[じょう]善[ぜん]は水[みず]の若[ごと]し。",
    "author": "老子とされる言葉",
    "source": "『老子道徳経』",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/老子道徳経"
  },
  {
    "id": "q023",
    "ruby": "足[た]るを知[し]る者[もの]は富[と]む。",
    "author": "老子とされる言葉",
    "source": "『老子道徳経』",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/老子道徳経"
  },
  {
    "id": "q024",
    "ruby": "大[たい]器[き]は晩[ばん]成[せい]す。",
    "author": "老子とされる言葉",
    "source": "『老子道徳経』",
    "category": "成長",
    "sourceUrl": "https://ja.wikisource.org/wiki/老子道徳経"
  },
  {
    "id": "q025",
    "ruby": "知[し]る者[もの]は言[い]わず、言[い]う者[もの]は知[し]らず。",
    "author": "老子とされる言葉",
    "source": "『老子道徳経』",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/老子道徳経"
  },
  {
    "id": "q026",
    "ruby": "明[めい]鏡[きょう]止[し]水[すい]。",
    "author": "荘子とされる言葉",
    "source": "『荘子』",
    "category": "心",
    "sourceUrl": "https://ja.wikisource.org/wiki/荘子"
  },
  {
    "id": "q027",
    "ruby": "井[い]の中[なか]の蛙[かわず]、大[たい]海[かい]を知[し]らず。",
    "author": "荘子に由来するとされる言葉",
    "source": "『荘子』秋水",
    "category": "視野",
    "sourceUrl": "https://ja.wikisource.org/wiki/荘子"
  },
  {
    "id": "q028",
    "ruby": "人[じん]間[かん]万[ばん]事[じ]塞[さい]翁[おう]が馬[うま]。",
    "author": "故事成語",
    "source": "『淮南子』人間訓",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/淮南子"
  },
  {
    "id": "q029",
    "ruby": "百[ひゃく]聞[ぶん]は一[いっ]見[けん]に如[し]かず。",
    "author": "故事成語",
    "source": "『漢書』趙充国伝",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/漢書"
  },
  {
    "id": "q030",
    "ruby": "先[ま]ず隗[かい]より始[はじ]めよ。",
    "author": "故事成語",
    "source": "『戦国策』燕策",
    "category": "一歩",
    "sourceUrl": "https://ja.wikisource.org/wiki/戦国策"
  },
  {
    "id": "q031",
    "ruby": "蛇[だ]足[そく]を加[くわ]う。",
    "author": "故事成語",
    "source": "『戦国策』斉策",
    "category": "ことば",
    "sourceUrl": "https://ja.wikisource.org/wiki/戦国策"
  },
  {
    "id": "q032",
    "ruby": "楚[そ]人[じん]に盾[たて]と矛[ほこ]とを鬻[ひさ]ぐ者[もの]有[あ]り。",
    "author": "故事成語",
    "source": "『韓非子』難勢",
    "category": "ことば",
    "sourceUrl": "https://ja.wikisource.org/wiki/韓非子"
  },
  {
    "id": "q033",
    "ruby": "玉[たま]磨[みが]かざれば光[ひかり]なし。",
    "author": "古典に基づく言葉",
    "source": "『礼記』学記",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/礼記"
  },
  {
    "id": "q034",
    "ruby": "切[せつ]磋[さ]琢[たく]磨[ま]。",
    "author": "古典に基づく言葉",
    "source": "『詩経』衛風",
    "category": "学び",
    "sourceUrl": "https://ja.wikisource.org/wiki/詩経"
  },
  {
    "id": "q035",
    "ruby": "一[いっ]寸[すん]の光[こう]陰[いん]軽[かろ]んずべからず。",
    "author": "朱熹の詩に基づく言葉",
    "source": "朱熹『偶成』",
    "category": "時間",
    "sourceUrl": "https://ja.wikisource.org/wiki/偶成_(朱熹)"
  },
  {
    "id": "q036",
    "ruby": "和[わ]を以[もっ]て貴[とうと]しとなす。",
    "author": "聖徳太子とされる言葉",
    "source": "『十七条憲法』第一条",
    "category": "人との関わり",
    "sourceUrl": "https://ja.wikisource.org/wiki/十七条憲法"
  },
  {
    "id": "q037",
    "ruby": "一[いち]期[ご]一[いち]会[え]。",
    "author": "井伊直弼の茶道論に基づく言葉",
    "source": "『茶湯一会集』",
    "category": "出会い",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q038",
    "ruby": "初[しょ]心[しん]忘[わす]るべからず。",
    "author": "世阿弥の言葉",
    "source": "『花鏡』",
    "category": "成長",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q039",
    "ruby": "日[ひ]々[び]是[こ]好[よ]日[ひ]。",
    "author": "禅語",
    "source": "『碧巌録』",
    "category": "心",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q040",
    "ruby": "百[ひゃく]尺[しゃく]竿[かん]頭[とう]一[いっ]歩[ぽ]を進[すす]む。",
    "author": "禅語",
    "source": "『景徳伝灯録』",
    "category": "一歩",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q041",
    "ruby": "七[なな]転[ころ]び八[や]起[お]き。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "挑戦",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q042",
    "ruby": "石[いし]の上[うえ]にも三[さん]年[ねん]。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "継続",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q043",
    "ruby": "継[けい]続[ぞく]は力[ちから]なり。",
    "author": "近代の標語とされる言葉",
    "source": "日本の標語",
    "category": "継続",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q044",
    "ruby": "雨[あめ]垂[だ]れ石[いし]を穿[うが]つ。",
    "author": "故事成語",
    "source": "『漢書』枚乗伝",
    "category": "継続",
    "sourceUrl": "https://ja.wikisource.org/wiki/漢書"
  },
  {
    "id": "q045",
    "ruby": "塵[ちり]も積[つ]もれば山[やま]となる。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "継続",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q046",
    "ruby": "急[いそ]がば回[まわ]れ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "生き方",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q047",
    "ruby": "笑[わら]う門[かど]には福[ふく]来[き]たる。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "心",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q048",
    "ruby": "良[りょう]薬[やく]は口[くち]に苦[にが]し。",
    "author": "故事成語",
    "source": "『史記』留侯世家",
    "category": "成長",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q049",
    "ruby": "情[なさ]けは人[ひと]のためならず。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "人との関わり",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q050",
    "ruby": "好[す]きこそ物[もの]の上[じょう]手[ず]なれ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "学び",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q051",
    "ruby": "習[なら]うより慣[な]れよ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "学び",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q052",
    "ruby": "早[はや]起[お]きは三[さん]文[もん]の徳[とく]。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "生活",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q053",
    "ruby": "災[わざわ]い転[てん]じて福[ふく]となす。",
    "author": "故事成語",
    "source": "『戦国策』燕策",
    "category": "生き方",
    "sourceUrl": "https://ja.wikisource.org/wiki/戦国策"
  },
  {
    "id": "q054",
    "ruby": "念[ねん]には念[ねん]を入[い]れよ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "学び",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q055",
    "ruby": "類[るい]は友[とも]を呼[よ]ぶ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "人との関わり",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q056",
    "ruby": "能[のう]ある鷹[たか]は爪[つめ]を隠[かく]す。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "生き方",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q057",
    "ruby": "身[み]を捨[す]ててこそ浮[う]かぶ瀬[せ]もあれ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "挑戦",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q058",
    "ruby": "ならぬ堪[かん]忍[にん]するが堪[かん]忍[にん]。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "生き方",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q059",
    "ruby": "明[あ]日[し]は明[あ]日[し]の風[かぜ]が吹[ふ]く。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "生き方",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q060",
    "ruby": "まかぬ種[たね]は生[は]えぬ。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "行動",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q061",
    "ruby": "失[しっ]敗[ぱい]は成[せい]功[こう]のもと。",
    "author": "ことわざ",
    "source": "日本のことわざ",
    "category": "挑戦",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q062",
    "ruby": "人[ひと]の一[いっ]生[しょう]は重[おも]荷[に]を負[お]うて遠[とお]き道[みち]をゆくがごとし、急[いそ]ぐべからず。",
    "author": "徳川家康の遺訓とされる言葉",
    "source": "徳川家康遺訓",
    "category": "生き方",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q063",
    "ruby": "及[およ]ばざるは過[す]ぎたるより勝[まさ]れり。",
    "author": "徳川家康の遺訓とされる言葉",
    "source": "徳川家康遺訓",
    "category": "生き方",
    "sourceUrl": "https://meigen-zukan.com/"
  },
  {
    "id": "q064",
